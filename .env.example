# Copy to .env and adjust. Values below match docker-compose.yml.

# --- Database ---
DATABASE_URL=postgres://nihongo:nihongo@localhost:5432/nihongo

# --- Redis (jobs, later) ---
REDIS_URL=redis://localhost:6380

# --- Object storage (MinIO locally, Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=nihongo-media
S3_ACCESS_KEY_ID=nihongo
S3_SECRET_ACCESS_KEY=nihongo-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/nihongo-media

# --- Auth (Phase 7c) ---
JWT_SECRET=change-me-to-a-long-random-string
APPLE_CLIENT_ID=com.bilguun.nihongo
GOOGLE_CLIENT_ID=

# --- Observability ---
SENTRY_DSN=

# --- API ---
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=
