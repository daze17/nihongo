# Copy to .env and adjust. Values below match docker-compose.yml.

# --- Database ---
DATABASE_URL=postgres://nihongo:nihongo@localhost:5432/nihongo

# --- Redis (jobs, later) ---
REDIS_URL=redis://localhost:6380

# --- Object storage (MinIO locally, Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=nihongo-media
S3_ACCESS_KEY_ID=nihongo
S3_SECRET_ACCESS_KEY=nihongo-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/nihongo-media

# --- Auth: Auth0 (README, "Auth0 setup") ---
# Empty = sign-in disabled in dev (/v1/me answers 503). Required in production.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.nihongo.app

# --- Observability ---
SENTRY_DSN=

# --- API ---
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=
