{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations, client and seed helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node --env-file-if-exists=../../.env dist/migrate.js",
    "db:seed": "pnpm build && node --env-file-if-exists=../../.env dist/seed.js",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@repo/content": "workspace:*",
    "@repo/schema": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
