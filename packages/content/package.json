{
  "name": "@repo/content",
  "version": "0.0.0",
  "private": true,
  "description": "Builds lesson JSON from JMdict, KanjiVG, KANJIDIC2 and Tatoeba",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
