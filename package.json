{
  "name": "japanese-learn",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gen": "turbo run gen",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yaml,yml}\"",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "test:e2e": "turbo run test:e2e",
    "backend:dev": "pnpm --filter backend dev",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:studio": "pnpm --filter @repo/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~6.0.3"
    }
  }
}
