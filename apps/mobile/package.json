{
  "name": "mobile",
  "private": true,
  "description": "Flutter app. Scripts expose flutter/dart commands to Turborepo.",
  "scripts": {
    "gen": "dart run build_runner build --delete-conflicting-outputs",
    "lint": "flutter analyze",
    "format": "dart format lib test",
    "format:check": "dart format --set-exit-if-changed lib test",
    "test": "flutter test",
    "build": "flutter build apk --debug",
    "build:ios": "flutter build ipa --release",
    "build:android": "flutter build appbundle --release",
    "dev": "flutter run"
  }
}
