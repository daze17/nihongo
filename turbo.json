{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.json"],
  "tasks": {
    "gen": {
      "outputs": ["lib/**/*.g.dart", "lib/**/*.freezed.dart"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/app/outputs/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "openapi": {
      "dependsOn": ["build"],
      "outputs": ["dist/openapi.json"]
    }
  }
}
